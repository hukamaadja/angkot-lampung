<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="920.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.angkotlampung.PrimaryController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <TabPane prefHeight="570.0" prefWidth="890.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- TAB 1: DATA RUTE -->
                <Tab text="Data Rute">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <TextField fx:id="fieldCari" promptText="Cari tempat pemberhentian..." prefWidth="250.0" />
                                        <Button text="Cari" onAction="#handleCari" />
                                        <Button text="Tampilkan Semua" onAction="#handleSemuaRute" />
                                    </children>
                                </HBox>
                                <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <TableView fx:id="tabelRute" prefWidth="600.0" HBox.hgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="kolKode" prefWidth="80.0" text="Kode" />
                                                <TableColumn fx:id="kolNama" prefWidth="180.0" text="Nama Rute" />
                                                <TableColumn fx:id="kolAwal" prefWidth="120.0" text="Titik Awal" />
                                                <TableColumn fx:id="kolAkhir" prefWidth="120.0" text="Titik Akhir" />
                                            </columns>
                                        </TableView>
                                        <VBox spacing="5.0" prefWidth="250.0">
                                            <children>
                                                <Label text="Detail Pemberhentian:" />
                                                <ListView fx:id="listPemberhentian" VBox.vgrow="ALWAYS" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <TextField fx:id="fieldKode" promptText="Kode" prefWidth="70.0" />
                                        <TextField fx:id="fieldNamaRute" promptText="Nama Rute" prefWidth="150.0" />
                                        <TextField fx:id="fieldAwal" promptText="Titik Awal" prefWidth="120.0" />
                                        <TextField fx:id="fieldAkhir" promptText="Titik Akhir" prefWidth="120.0" />
                                        <TextField fx:id="fieldTengah" promptText="Transit (pisah koma)" prefWidth="180.0" />
                                        <Button text="Tambah Rute" onAction="#handleTambahRute" />
                                    </children>
                                </HBox>
                                <Label fx:id="labelTotalRute" text="Total rute: 0" />
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- TAB 2: DATA ANGKOT -->
                <Tab text="Data Angkot">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <TableView fx:id="tabelAngkot" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="kolJenis" prefWidth="110.0" text="Jenis" />
                                        <TableColumn fx:id="kolPlat" prefWidth="100.0" text="Plat Nomor" />
                                        <TableColumn fx:id="kolSopir" prefWidth="130.0" text="Nama Sopir" />
                                        <TableColumn fx:id="kolRuteAngkot" prefWidth="180.0" text="Rute" />
                                        <TableColumn fx:id="kolTarif" prefWidth="100.0" text="Tarif Dasar" />
                                        <TableColumn fx:id="kolKeterangan" prefWidth="150.0" text="Keterangan" />
                                    </columns>
                                </TableView>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <ComboBox fx:id="comboJenis" prefWidth="110.0" />
                                        <TextField fx:id="fieldPlat" promptText="Plat Nomor" prefWidth="100.0" />
                                        <TextField fx:id="fieldSopir" promptText="Nama Sopir" prefWidth="120.0" />
                                        <ComboBox fx:id="comboRute" promptText="Pilih Rute" prefWidth="150.0" />
                                        <TextField fx:id="fieldTarif" promptText="Tarif Dasar" prefWidth="100.0" />
                                        <Label fx:id="labelExtra" text="Kapasitas (orang):" />
                                        <TextField fx:id="fieldExtra" promptText="Nilai" prefWidth="80.0" />
                                        <Button text="Tambah Angkot" onAction="#handleTambahAngkot" />
                                    </children>
                                </HBox>
                                <Label fx:id="labelTotalAngkot" text="Total angkot terdaftar: 0" />
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- TAB 3: HITUNG TARIF -->
                <Tab text="Hitung Tarif">
                    <content>
                        <VBox alignment="TOP_LEFT" spacing="15.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Pilih Angkot:" prefWidth="120.0" />
                                        <ComboBox fx:id="comboAngkotTarif" prefWidth="300.0" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Jumlah Penumpang:" prefWidth="120.0" />
                                        <TextField fx:id="fieldPenumpang" promptText="Jumlah orang" prefWidth="150.0" />
                                    </children>
                                </HBox>
                                <Button text="Hitung Total Tarif" onAction="#handleHitung" />
                                <Label fx:id="labelHasil" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Total tarif: -" />
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>